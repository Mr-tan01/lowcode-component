{
    "name": "lowcode-component",
    "private": true,
    "version": "0.1.0-alpha.3.3.0",
    "type": "module",
    "main": "dist/index.prod.mjs",
    "types": "dist/types/index.d.ts",
    "scripts": {
        "dev": "vite && vue-tsc --noEmit",
        "docx": "vue-tsc -b && vite build",
        "build": "cd /scripts && node ./vite.lib.js",
        "build:lib": "vue-tsc -b && vite build --config vite.config.lib.ts",
        "lib": "pnpm --filter scripts build",
        "preview": "vite preview",
        "prepare": "husky install",
        "lint": "eslint \"**/*.{ts,vue}\"",
        "lint:fix": "eslint \"**/*.{ts,vue}\" --fix",
        "format": "prettier --write \"**/*.{js,ts,vue}\"",
        "lint-staged": "lint-staged"
    },
    "files": [
        "es",
        "dist"
    ],
    "dependencies": {
        "@mmj-code-lib/lowcode": "git+http://liangweizhu@siteshun:8f7LGw5uYhcbz-z8vo14@code.siteshun.com:800/front-component/STS/mmj-code-lib.git#lowcode-0.1.0",
        "lowcode-share": "git+http://code.siteshun.com:800/front-component/lowcode-sview/lowcode-share.git#develop"
    },
    "devDependencies": {
        "@cesium/engine": "^16.0.0",
        "@cesium/widgets": "^11.1.0",
        "@eslint/js": "^9.30.0",
        "@mmj-code-lib/scripts": "git+http://code.siteshun.com:800/front-component/STS/mmj-code-lib.git#scripts",
        "@stylistic/eslint-plugin": "^5.1.0",
        "@types/echarts": "^5.0.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.10.7",
        "@vicons/ionicons5": "^0.13.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/repl": "^4.5.1",
        "@vue/tsconfig": "^0.7.0",
        "@vueuse/core": "^12.5.0",
        "axios": "^1.8.4",
        "cesium": "^1.128.0",
        "cesium-heatmap-es6": "^0.8.0",
        "commander": "^13.1.0",
        "echarts": "^5.6.0",
        "eslint": "^9.30.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.5.1",
        "eslint-plugin-vue": "^10.2.0",
        "globals": "^16.2.0",
        "highlight.js": "^11.11.1",
        "husky": "8.0.0",
        "lint-staged": "^16.1.2",
        "localforage": "^1.10.0",
        "lodash-es": "^4.17.21",
        "naive-ui": "^2.41.0",
        "prettier": "^3.6.2",
        "resize-observer-polyfill": "^1.5.1",
        "sass-embedded": "^1.83.4",
        "tsup": "^8.4.0",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.35.0",
        "vite": "^5.4.13",
        "vite-plugin-cesium": "^1.2.23",
        "vite-plugin-dts": "^4.5.0",
        "vite-plugin-lib-inject-css": "^2.2.1",
        "vue": "^3.5.13",
        "vue-resizable": "^2.1.7",
        "vue-router": "^4.5.0",
        "vue-tsc": "^2.2.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
            "prettier --write--parser json"
        ],
        "package.json": [
            "prettier --write"
        ],
        "*.vue": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,less,styl,html,md}": [
            "prettier --write"
        ]
    }
}
